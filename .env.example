# Machine-local configuration. Copy to .env.local or point ACTIONS_RUNNERS_ENV elsewhere.
# Do not commit the real machine file.

ACTIONS_RUNNERS_HOME="${ACTIONS_RUNNERS_HOME:-$HOME/actions-runners}"
RUNNERS_CONFIG="${RUNNERS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/actions-runners/runners.conf}"

# on-demand: services stay installed but disabled at boot; skills/CLI start only what is needed.
# auto: services are enabled and start with systemd.
RUNNER_BOOT_POLICY="${RUNNER_BOOT_POLICY:-on-demand}"

# Optional overrides:
# RUNNER_SERVICE_USER="$USER"
# RUNNER_SYSTEMD_START_SETTLE_SECONDS=3
